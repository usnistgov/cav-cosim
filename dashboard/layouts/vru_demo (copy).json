        "imageTopic": "/dashboard/chase_image"
      }
    },
    "Image!perception": {
      "topic": "/perception/image_debug",
      "smooth": true,
      "synchronize": false,
      "rotation": 0,
      "minValue": null,
      "maxValue": null,
      "transformMarkers": false,
      "calibrationTopic": "",
      "cameraInfoTopic": "",
