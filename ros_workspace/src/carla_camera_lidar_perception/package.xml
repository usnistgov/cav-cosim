<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>carla_camera_lidar_perception</name>
  <version>0.1.0</version>
  <description>Camera + LiDAR fusion perception node for VRU detection in CARLA. YOLO detects in image; LiDAR provides depth. Same node serves ego (vehicle-mounted) and RSU (pole-mounted) — different sensor topic prefix.</description>
  <maintainer email="research@iotav.org">VRU Research</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>cv_bridge</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
